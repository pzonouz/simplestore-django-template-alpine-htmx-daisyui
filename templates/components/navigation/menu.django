<div x-data="{ menu: JSON.parse(document.getElementById('menu-data').textContent) }">
    <template id="menu-node">
        <li class="relative [&:hover>ul]:flex"
            x-data="{ hasChildren: Boolean(item.children && item.children.length > 0) }">
            <template x-if="hasChildren">
                <div class="flex items-center justify-between gap-2 px-4 py-2 hover:bg-sky-950 hover:text-sky-50 transition-colors whitespace-nowrap cursor-pointer rounded-md">
                    <span x-text="item.title"></span>
                    <span :class="isRoot ? 'icon-[heroicons--chevron-down-20-solid]' : 'icon-[heroicons--chevron-left-20-solid]'"
                          class="text-lg"></span>
                </div>
            </template>
            <template x-if="!hasChildren">
                <a :href="item.url || '#'"
                   class="flex items-center justify-between gap-2 px-4 py-2 hover:bg-sky-950 hover:text-sky-50 transition-colors whitespace-nowrap cursor-pointer rounded-md">
                    <span x-text="item.title"></span>
                </a>
            </template>
            <template x-if="hasChildren">
                <ul :class="isRoot ? 'top-full right-0' : 'top-0 right-full'"
                    class="hidden absolute flex-col min-w-48 bg-white text-sky-950 rounded-md shadow-lg border border-gray-100 py-2 z-50">
                    <template x-for="child in item.children" :key="child.title">
                        <li x-data="{ item: child, isRoot: false }"
                            x-html="document.getElementById('menu-node').innerHTML"></li>
                    </template>
                </ul>
            </template>
        </li>
    </template>
    <ul style="font-family:yekan"
        class="flex flex-row justify-start items-center h-20 px-4 bg-gray-50 text-sky-950 rounded-sm w-3/4 mx-auto">
        <template x-for="item in menu" :key="item.title">
            <li x-data="{ item: item, isRoot: true }"
                x-html="document.getElementById('menu-node').innerHTML"></li>
        </template>
    </ul>
</div>
