{
  "venvPath": ".",
  "venv": ".venv",
  "include": ["**/*.py"],
  "exclude": [
    "**/migrations/**",
    "**/tests/**",
    "**/__pycache__/**",
    ".venv/**"
  ],
  "extraPaths": ["."],
  "pyhtonVersion": "3.13.15",
  "typeCheckingMode": "basic",
  "reportMissingTypeStubs": false,
  "reportAttributeAccessIssue":false
}
